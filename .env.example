# PostgreSQL connection string used by the API server, migrations and seed.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/contract_portal

# API server port (Vite dev server proxies /api and /uploads here).
PORT=3001

# Data-currency policy: a record older than this many days is flagged as stale.
STALE_DAYS_FINANCIALS=30
STALE_DAYS_STAFFING=7

# ============================================================================
# Database Configuration (REQUIRED)
# ============================================================================

# PostgreSQL connection string used by the API server, migrations and seed.
# For Docker: postgres://postgres:postgres@db:5432/contract_portal
# For local PostgreSQL: postgres://postgres:postgres@localhost:5432/contract_portal
DATABASE_URL=postgres://postgres:postgres@db:5432/contract_portal

# ============================================================================
# Server Configuration
# ============================================================================

# API server port (Vite dev server proxies /api and /uploads here).
# Default: 3000 for Docker, 3001 for local npm
PORT=3000

# Frontend URL (for CORS and redirects)
# Development default: http://localhost:5173
# Production: Set to your deployed domain
FRONTEND_URL=http://localhost:5173

# ============================================================================
# Authentication & Security (REQUIRED)
# ============================================================================

# JWT Authentication Secret - CHANGE IN PRODUCTION!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-here-change-in-production

# Session Secret - CHANGE IN PRODUCTION!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-here-change-in-production

# Token expiration times
# JWT_EXPIRY: Short-lived access token (default: 15m)
# REFRESH_TOKEN_EXPIRY: Long-lived refresh token (default: 7d)
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ============================================================================
# Azure AD / Microsoft Entra ID SSO (OPTIONAL)
# ============================================================================

# Leave blank to disable SSO, or configure for Microsoft authentication
# Follow setup guide: AZURE_SETUP.md

# Your organization's tenant ID from Azure Portal
AZURE_TENANT_ID=

# Application (client) ID from app registration
AZURE_CLIENT_ID=

# Client secret from app registration
AZURE_CLIENT_SECRET=

# Callback URL registered in Azure (must match app registration)
AZURE_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# ============================================================================
# Email Service (OPTIONAL)
# ============================================================================

# Configure for password reset emails. Leave blank to disable email features.

# SMTP server hostname
EMAIL_HOST=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
EMAIL_PORT=587

# SMTP username/email
EMAIL_USER=

# SMTP password or app-specific password
EMAIL_PASS=

# From address for outgoing emails
EMAIL_FROM=noreply@techsur.com

# ============================================================================
# Data Currency Policy
# ============================================================================

# Data-currency policy: records older than these thresholds are flagged as stale.
# Values in days.
STALE_DAYS_FINANCIALS=30
STALE_DAYS_STAFFING=7

# ============================================================================
# Development & Debugging
# ============================================================================

# Node environment (development | production)
NODE_ENV=development

# Enable verbose logging (true | false)
DEBUG=false

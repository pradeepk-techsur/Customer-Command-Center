{
  "name": "contract-transparency-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Contract Transparency Portal for the AOUSC BPA for TSO Support Services (47QTCA20D00C6)",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node --experimental-strip-types server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed": "tsx server/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "~5.9.0",
    "vite": "^8.0.0"
  }
}
